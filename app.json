{
  "expo": {
    "name": "READ-Y AMIGO",
    "slug": "READ-YAMIGO",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "readyamigo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.readyamigo.app",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow Read-Y Amigo to show the words you read aloud.",
        "NSMicrophoneUsageDescription": "Allow Read-Y Amigo to record your reading."
      }
    },
    "android": {
      "package": "com.readyamigo.app",
      "adaptiveIcon": {
        "backgroundColor": "#FDECAF",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Read-Y Amigo to use your microphone so you can record your reading."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Read-Y Amigo to record your reading.",
          "speechRecognitionPermission": "Allow Read-Y Amigo to show the words you read aloud."
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d7316867-324c-48ea-ab64-3791cfb855f9"
      }
    }
  }
}
